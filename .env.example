# Copy to .env only for local use. Never commit real credentials.
# Understanding uses the current Codex session with transcript text.
# Audio does not read video frames.
# The following settings are only for OPTIONAL cloud speech transcription.
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
# Optional explicit executable; imageio-ffmpeg is used automatically when unset.
FFMPEG=
# Mainland China model download fallback, when needed:
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1
# Optional cloud OCR; local PDF page rendering does not need these:
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
